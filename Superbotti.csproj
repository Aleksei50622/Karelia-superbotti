<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="NetCord" Version="1.0.0-beta.28" />
		<PackageReference Include="NetCord.Hosting" Version="1.0.0-beta.28" />
		<PackageReference Include="NetCord.Hosting.AspNetCore" Version="1.0.0-beta.28" />
		<PackageReference Include="NetCord.Hosting.Services" Version="1.0.0-beta.28" />
		<PackageReference Include="NetCord.Services" Version="1.0.0-beta.28" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="appsettings.dev.json">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="appsettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

</Project>
